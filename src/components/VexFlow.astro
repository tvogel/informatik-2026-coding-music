---
interface Props {
  code: string;
  width?: number;
  height?: number;
}

const { code, width = 500, height = 180 } = Astro.props;
const id = crypto.randomUUID();
---

<RootElement
  ><div
    class="vexflow-target"
    id={id}
    data-target="vexflow"
    data-code={code}
    data-width={width}
    data-height={height}
  >
  </div></RootElement
>
<script>
  import VexFlow, { Factory } from "vexflow";

  function setFgColor(factory: Factory, fgColor: string) {
    const fgStyle = {
      strokeStyle: fgColor,
      fillStyle: fgColor,
    };
    factory.getStave()?.setStyle(fgStyle);
    factory.getStave()?.setDefaultLedgerLineStyle(fgStyle);
    factory.getVoices().forEach((voice) => {
      voice.setStyle(fgStyle);
      voice.getTickables().forEach((tickable) => {
        tickable.setStyle(fgStyle);
        if (tickable instanceof VexFlow.Note)
          tickable.getBeam()?.setStyle(fgStyle);
      });
    });
  }

  function commitHook(obj: any, note: any, builder: any) {
    if ("art" in obj)
      note.addModifier(builder.factory.Articulation({ type: obj.art }));
  }

  RootElement.ready(($) => {
    const target = $("vexflow");
    const code = target.dataset.code ?? "";
    const width = Number(target.dataset.width ?? 500);
    const height = Number(target.dataset.height ?? 180);

    const func = new Function(`return (${code})`)();

    const factory = new VexFlow.Factory({
      renderer: { elementId: target.id, width, height },
    });

    function render() {
      target.replaceChildren();

      const style = window.getComputedStyle(document.body);
      const fgColor = style.getPropertyValue("--sl-color-text") || "white";
      factory.initRenderer();
      const score = factory.EasyScore({ commitHooks: [commitHook] });
      VexFlow.setFonts("Bravura");
      func(VexFlow, factory, score);
      setFgColor(factory, fgColor);
      factory.getContext().scale(1.25, 1.25);
      factory.draw();
    }

    const observer = new MutationObserver(render);
    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme"],
    });
    render();
  });
</script>

<style>
  .vexflow-target {
    padding: 1rem;
  }
</style>
