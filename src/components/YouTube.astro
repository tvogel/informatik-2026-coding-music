---
/*
 * astro-embed's YouTube embed, which prints as a small placeholder like a
 * LinkCard, with a QR code and the link, instead of an empty box.
 */
import { YouTube as Embed } from "astro-embed";
import QrCode from "./QrCode.astro";

type Props = Parameters<typeof Embed>[0];

const props = Astro.props;
const href = `https://youtu.be/${props.id}`;
---

<div class="youtube">
  <div class="youtube__screen">
    <Embed {...props} />
  </div>
  <div class="youtube__print not-content">
    <QrCode href={href} />
    <div class="youtube__body">
      <a class="youtube__card" href={href}>
        Video{props.title && `: ${props.title}`}
      </a>
      <span class="youtube__url">{href}</span>
    </div>
  </div>
</div>

<style>
  .youtube__print {
    display: none;
  }

  @media print {
    .youtube__screen {
      display: none;
    }

    /* as in LinkCard */
    .youtube__print {
      display: flex;
      gap: 1rem;
      align-items: center;
      break-inside: avoid;
    }

    .youtube__body {
      flex: 1;
      min-width: 0;
    }

    .youtube__card {
      display: block;
      padding: 1rem;
      border: 1px solid var(--sl-color-gray-5);
      border-radius: 0.5rem;
      color: var(--sl-color-white);
      font-size: var(--sl-text-lg);
      font-weight: 600;
      line-height: var(--sl-line-height-headings);
      text-decoration: none;
    }

    .youtube__url {
      display: block;
      margin-top: 0.25rem;
      font-size: var(--sl-text-sm);
      overflow-wrap: anywhere;
    }
  }
</style>
