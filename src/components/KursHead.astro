---
import Default from "@astrojs/starlight/components/Head.astro";
import { pwaInfo } from "virtual:pwa-info";

const basePath = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<Default><slot /></Default>
<script is:inline>
  // Always print in the light theme, so that buttons etc. look right on
  // paper. Everything (Starlight, VexFlow) follows `data-theme`.
  (() => {
    const root = document.documentElement;
    let theme;
    addEventListener("beforeprint", () => {
      theme = root.dataset.theme;
      root.dataset.theme = "light";
    });
    addEventListener("afterprint", () => {
      if (theme === undefined) delete root.dataset.theme;
      else root.dataset.theme = theme;
    });
  })();
</script>
<script>
  import * as Strudel from "@strudel/repl";
  await Strudel.prebake();
  declare global {
    interface Window {
      Pattern: any;
    }
    var __strudelPatched: boolean | undefined;
  }
  if (globalThis.__strudelPatched) {
    console.warn("Strudel has already been patched.");
  } else {
    globalThis.__strudelPatched = true;
    console.log("Patching Strudel.");
    const origSpiral = window.Pattern.prototype.spiral;
    window.Pattern.prototype.spiral = function (options: any) {
      return origSpiral.call(this, { inset: 2, ...options });
    };
  }
</script>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="icon" href={`${basePath}favicon.svg`} type="image/svg+xml" />
<link rel="apple-touch-icon" href={`${basePath}icons/apple-icon-180.png`} />
<link rel="mask-icon" href={`${basePath}favicon.svg`} color="#FFFFFF" />
<meta name="msapplication-TileColor" content="#FFFFFF" />
<meta name="theme-color" content="#00807e" />
<script src="/src/pwa.ts"></script>
{pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
