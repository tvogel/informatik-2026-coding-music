---
interface Props {
  name?: string;
  tune?: string;
  /**
   * - `full`: editable, with undo/redo and the original tune next to it
   * - `playOnly`: only plays `tune`, with small start/stop buttons
   * - `displayOnly`: only shows `tune`
   */
  mode?: "full" | "playOnly" | "displayOnly";
}

const { name, tune = "", mode = "full" } = Astro.props;
const displayOnly = mode === "displayOnly";
const playOnly = mode === "playOnly";
const hasDefaultTune = tune.trim().length > 0;
---

<RootElement>
  <div
    class:list={[
      "root not-content",
      { "root--play-only": playOnly, "root--display-only": displayOnly },
    ]}
    data-target="mini-repl"
    data-mini-repl
    data-default-tune={tune}
    data-mini-repl-name={name}
    data-play-only={playOnly ? "" : undefined}
  >
    {
      !displayOnly && (
        <div class="editor-pane">
          <div class="controls">
            <div class="controls__group controls__group--transport">
              <button
                aria-label="Start"
                data-target="start"
                title="Start"
                type="button"
              >
                <span aria-hidden="true">►</span>
              </button>
              <button
                aria-label="Stop"
                data-target="stop"
                title="Stop"
                type="button"
              >
                <span aria-hidden="true">■</span>
              </button>
            </div>
            {!playOnly && (
              <div class="controls__group">
                <button
                  aria-label="Rückgängig"
                  data-target="undo"
                  title="Rückgängig"
                  type="button"
                >
                  <span aria-hidden="true">↶</span>
                </button>
                <button
                  aria-label="Wiederholen"
                  data-target="redo"
                  title="Wiederholen"
                  type="button"
                >
                  <span aria-hidden="true">↷</span>
                </button>
              </div>
            )}
          </div>
          <div class="editor" data-target="strudel" />
          <p class="error" data-target="error" aria-live="polite" hidden />
        </div>
      )
    }
    {
      hasDefaultTune &&
        !playOnly &&
        ((!displayOnly && (
          <aside class="code-pane" aria-label="Original tune">
            <button
              aria-label="Diesen Original-Code wiederherstellen"
              class="code-pane__reset"
              data-target="reset"
              title="Diesen Original-Code wiederherstellen"
              type="button"
            >
              <span aria-hidden="true">↺</span>
            </button>
            <div data-target="reference" data-default-tune={tune} />
          </aside>
        )) || <div data-target="reference" data-default-tune={tune} />)
    }
  </div>
</RootElement>

<script>
  import {
    makeStorageKey,
    readLocalStorage,
    writeLocalStorage,
  } from "../lib/localStorage";

  /**
   * Stopping Strudel only stops scheduling: notes already playing ring out,
   * which takes a while with long notes (e.g. `.slow(4)`). Resetting
   * superdough's output cuts them off; new notes reconnect on their own.
   * With `fade`, the output fades out first to avoid a click.
   */
  const silence = (fade: boolean, stillSilent = () => true) => {
    const controller = (globalThis as any).getSuperdoughAudioController?.();
    if (!controller) return;
    if (!fade) return controller.reset();
    const { audioContext, output } = controller;
    output.destinationGain?.gain.setTargetAtTime(0, audioContext.currentTime, 0.01);
    setTimeout(() => {
      if (stillSilent()) controller.reset();
      else output.destinationGain?.gain.setTargetAtTime(1, audioContext.currentTime, 0.01);
    }, 60);
  };

  /**
   * Makes a `<strudel-editor>` view-only. Only setting `contenteditable` is
   * not enough: Chrome's EditContext input bypasses it.
   *
   * Strudel bundles its own copy of CodeMirror, so its classes have to be
   * taken from the live editor instead of being imported. `StateEffect` is
   * only reachable through one of Strudel's settings compartments
   * (`state.config` is internal, but Strudel is pinned by our patch).
   */
  const lockEditor = (repl: HTMLElement & { editor?: any }) => {
    let locked = false;
    const lock = () => {
      const view = repl.editor?.editor;
      if (locked || !view) return;
      locked = true;
      view.dom.classList.add("is-readonly-view");

      const EditorView = view.constructor;
      const EditorState = view.state.constructor;
      const compartment = view.state.config?.compartments?.keys().next().value;
      const StateEffect = compartment?.reconfigure([]).constructor;
      if (StateEffect?.appendConfig && EditorState.readOnly && EditorView.editable) {
        view.dispatch({
          effects: StateEffect.appendConfig.of([
            EditorState.readOnly.of(true),
            EditorView.editable.of(false),
          ]),
        });
      } else {
        console.warn("MiniRepl: cannot lock editor properly.");
        view.contentDOM.setAttribute("contenteditable", "false");
        view.contentDOM.setAttribute("aria-readonly", "true");
      }
    };
    repl.addEventListener("update", lock);
    queueMicrotask(lock);
  };

  RootElement.ready(async ($) => {
    const root = $("mini-repl");
    const strudel = $.optional("strudel");
    const reference = $.optional("reference");
    const playOnly = root.dataset.playOnly !== undefined;

    const defaultTune = root.dataset.defaultTune ?? "";
    const storageKey = makeStorageKey(
      "mini-repl",
      root,
      "[data-mini-repl]",
      root?.dataset.miniReplName,
    );

    // A play-only tune is never edited, so there is nothing to keep.
    const initialTune = playOnly
      ? defaultTune
      : (readLocalStorage(storageKey) ?? root.dataset.tune ?? defaultTune);
    root.dataset.tune = initialTune;

    let repl:
      | (HTMLElement & {
          editor?: {
            editor?: {
              contentDOM?: HTMLElement;
              focus?: () => void;
            };
            evaluate: () => void;
            stop: () => void;
          };
        })
      | undefined;
    if (strudel) {
      repl = document.createElement("strudel-editor");

      repl.setAttribute("code", initialTune);
      strudel.append(repl);
      if (playOnly) lockEditor(repl);

      const error = $("error");
      const showError = (message?: string) => {
        error.textContent = message ? `Fehler: ${message}` : "";
        error.hidden = !message;
      };
      let started = false;
      repl.addEventListener("update", ((event: Event) => {
        const detail = (
          event as CustomEvent<{
            code?: string;
            error?: Error;
            pending?: boolean;
            started?: boolean;
          }>
        ).detail;
        const code = detail.code ?? "";
        strudel.dataset.tune = code;
        if (!playOnly) writeLocalStorage(storageKey, code);
        started = detail.started ?? started;
        // a new evaluation starts with a clean slate
        if (detail.pending) showError();
        else if (detail.error) showError(detail.error.message);
      }) as EventListener);
      // Errors while playing (e.g. an unknown sound) are only logged globally.
      // With solo, only the started editor plays, so they belong to it.
      // Evaluation errors arrive per editor via "update" above.
      document.addEventListener("strudel.log", ((event: Event) => {
        const { message, type } = (
          event as CustomEvent<{ message: string; type?: string }>
        ).detail;
        const match = message.match(/^\[(\w+)\] error: (.*)$/s);
        if (!started || match?.[1] === "eval") return;
        if (match) showError(match[2]);
        else if (type === "error") showError(message);
      }) as EventListener);

      const triggerHistoryAction = (
        inputType: "historyUndo" | "historyRedo",
      ) => {
        const view = repl!.editor?.editor;
        const target = view?.contentDOM;
        if (!target) return;

        view?.focus?.();
        target.dispatchEvent(
          new InputEvent("beforeinput", {
            bubbles: true,
            cancelable: true,
            inputType,
          }),
        );
      };

      $("start").addEventListener("click", () => {
        // also cuts notes still ringing from another editor
        silence(false);
        repl!.editor?.evaluate();
      });

      $("stop").addEventListener("click", () => {
        repl!.editor?.stop();
        silence(true, () => !started);
      });

      $.optional("undo")?.addEventListener("click", () => {
        triggerHistoryAction("historyUndo");
      });

      $.optional("redo")?.addEventListener("click", () => {
        triggerHistoryAction("historyRedo");
      });
    }

    if (reference) {
      const referenceRepl = document.createElement("strudel-editor");

      referenceRepl.setAttribute("code", defaultTune);
      reference.append(referenceRepl);
      lockEditor(referenceRepl);

      if (strudel) {
        const reset = $("reset");
        reset.addEventListener("click", () => {
          strudel.dataset.tune = defaultTune;
          writeLocalStorage(storageKey, defaultTune);
          repl!.setAttribute("code", defaultTune);
        });
      }
    }
  });
</script>

<style>
  .root {
    display: grid;
    gap: 1rem;
    padding: 0.5rem;
  }

  .editor-pane {
    position: relative;
    gap: 0.75rem;
    padding-top: 2.75rem;
    overflow: hidden;
  }

  .controls {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
  }

  .controls__group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25em;
  }

  .controls button,
  .code-pane__reset {
    min-width: 2.5rem;
    padding: 0.35rem 0.55rem;
    line-height: 1;
  }

  .controls button span,
  .code-pane__reset span {
    display: inline-block;
    font-size: 1rem;
  }

  /* small start/stop buttons in front of the editor, not above it */
  .root--play-only .editor-pane {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0.5rem;
    padding-top: 0;
  }

  .root--play-only .controls {
    position: static;
  }

  .root--play-only .editor {
    flex: 1;
    min-width: 0;
  }

  .root--play-only .error {
    flex-basis: 100%;
    margin-top: 0;
  }

  .root--play-only .controls button {
    min-width: 1.75rem;
    padding: 0.2rem 0.35rem;
  }

  .root--play-only .controls button span {
    font-size: 0.75rem;
  }

  .error {
    margin: 0.5rem 0 0;
    padding: 0.25rem 0.5rem;
    border-inline-start: 0.25rem solid var(--sl-color-red);
    background-color: var(--sl-color-red-low);
    color: var(--sl-color-red-high);
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-sm);
    white-space: pre-wrap;
  }
  .error[hidden] {
    display: none;
  }
  .code-pane {
    position: relative;
    min-height: 0;
    padding-top: 2.75rem;
  }

  .code-pane__reset {
    position: absolute;
    top: 0;
    right: 0;
    z-index: 1;
    white-space: nowrap;
  }

  @media (min-width: 900px) {
    .root {
      grid-template-columns: minmax(18rem, 1.5fr) minmax(9rem, 1fr);
      align-items: start;
    }

    .editor-pane {
      grid-column: 1;
    }

    .code-pane {
      grid-column: 2;
    }

    /* no original tune next to it */
    .root--play-only,
    .root--display-only {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 899px) {
    .code-pane {
      max-height: 20rem;
    }
  }
</style>
