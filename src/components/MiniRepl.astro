---
interface Props {
  name?: string;
  tune?: string;
  displayOnly?: boolean;
}

const { name, tune = "", displayOnly = false } = Astro.props;
const hasDefaultTune = tune.trim().length > 0;
---

<RootElement>
  <div
    class="root not-content"
    data-target="mini-repl"
    data-mini-repl
    data-default-tune={tune}
    data-mini-repl-name={name}
  >
    {
      !displayOnly && (
        <div class="editor-pane">
          <div class="controls">
            <div class="controls__group controls__group--transport">
              <button
                aria-label="Start"
                data-target="start"
                title="Start"
                type="button"
              >
                <span aria-hidden="true">►</span>
              </button>
              <button
                aria-label="Stop"
                data-target="stop"
                title="Stop"
                type="button"
              >
                <span aria-hidden="true">■</span>
              </button>
            </div>
            <div class="controls__group">
              <button
                aria-label="Rückgängig"
                data-target="undo"
                title="Rückgängig"
                type="button"
              >
                <span aria-hidden="true">↶</span>
              </button>
              <button
                aria-label="Wiederholen"
                data-target="redo"
                title="Wiederholen"
                type="button"
              >
                <span aria-hidden="true">↷</span>
              </button>
            </div>
          </div>
          <div data-target="strudel" />
        </div>
      )
    }
    {
      hasDefaultTune &&
        ((!displayOnly && (
          <aside class="code-pane" aria-label="Original tune">
            <button
              aria-label="Diesen Original-Code wiederherstellen"
              class="code-pane__reset"
              data-target="reset"
              title="Diesen Original-Code wiederherstellen"
              type="button"
            >
              <span aria-hidden="true">↺</span>
            </button>
            <div data-target="reference" data-default-tune={tune} />
          </aside>
        )) || <div data-target="reference" data-default-tune={tune} />)
    }
  </div>
</RootElement>

<script>
  import {
    makeStorageKey,
    readLocalStorage,
    writeLocalStorage,
  } from "../lib/localStorage";

  RootElement.ready(async ($) => {
    const root = $("mini-repl");
    const strudel = $.optional("strudel");
    const reference = $.optional("reference");

    const defaultTune = root.dataset.defaultTune ?? "";
    const storageKey = makeStorageKey(
      "mini-repl",
      root,
      "[data-mini-repl]",
      root?.dataset.miniReplName,
    );

    const initialTune =
      readLocalStorage(storageKey) ?? root.dataset.tune ?? defaultTune;
    root.dataset.tune = initialTune;

    let repl:
      | (HTMLElement & {
          editor?: {
            editor?: {
              contentDOM?: HTMLElement;
              focus?: () => void;
            };
            evaluate: () => void;
            stop: () => void;
          };
        })
      | undefined;
    if (strudel) {
      repl = document.createElement("strudel-editor");

      repl.setAttribute("code", initialTune);
      strudel.append(repl);

      repl.addEventListener("update", ((event: Event) => {
        const detail = (event as CustomEvent<{ code?: string }>).detail;
        const code = detail.code ?? "";
        strudel.dataset.tune = code;
        writeLocalStorage(storageKey, code);
      }) as EventListener);

      const triggerHistoryAction = (
        inputType: "historyUndo" | "historyRedo",
      ) => {
        const view = repl!.editor?.editor;
        const target = view?.contentDOM;
        if (!target) return;

        view?.focus?.();
        target.dispatchEvent(
          new InputEvent("beforeinput", {
            bubbles: true,
            cancelable: true,
            inputType,
          }),
        );
      };

      $("start").addEventListener("click", () => {
        repl!.editor?.evaluate();
      });

      $("stop").addEventListener("click", () => {
        repl!.editor?.stop();
      });

      $("undo").addEventListener("click", () => {
        triggerHistoryAction("historyUndo");
      });

      $("redo").addEventListener("click", () => {
        triggerHistoryAction("historyRedo");
      });
    }

    if (reference) {
      const referenceRepl = document.createElement(
        "strudel-editor",
      ) as HTMLElement & {
        editor?: {
          editor?: {
            dispatch: (value: { effects: unknown }) => void;
          };
        };
      };

      referenceRepl.setAttribute("code", defaultTune);
      reference.append(referenceRepl);

      const lockReferenceEditor = () => {
        const referenceEditor = referenceRepl.editor?.editor as any;
        if (!referenceEditor?.contentDOM) return;

        referenceEditor.contentDOM.setAttribute("contenteditable", "false");
        referenceEditor.contentDOM.setAttribute("aria-readonly", "true");
        referenceEditor.dom?.classList.add("is-readonly-view");
        referenceEditor.dom?.classList.remove("cm-focused");
      };

      referenceRepl.addEventListener(
        "update",
        lockReferenceEditor as EventListener,
      );
      queueMicrotask(lockReferenceEditor);

      if (strudel) {
        const reset = $("reset");
        reset.addEventListener("click", () => {
          strudel.dataset.tune = defaultTune;
          writeLocalStorage(storageKey, defaultTune);
          repl!.setAttribute("code", defaultTune);
        });
      }
    }
  });
</script>

<style>
  .root {
    display: grid;
    gap: 1rem;
    padding: 0.5rem;
  }

  .editor-pane {
    position: relative;
    gap: 0.75rem;
    padding-top: 2.75rem;
    overflow: hidden;
  }

  .controls {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
  }

  .controls__group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25em;
  }

  .controls button,
  .code-pane__reset {
    min-width: 2.5rem;
    padding: 0.35rem 0.55rem;
    line-height: 1;
  }

  .controls button span,
  .code-pane__reset span {
    display: inline-block;
    font-size: 1rem;
  }

  .code-pane {
    position: relative;
    min-height: 0;
    padding-top: 2.75rem;
  }

  .code-pane__reset {
    position: absolute;
    top: 0;
    right: 0;
    z-index: 1;
    white-space: nowrap;
  }

  @media (min-width: 900px) {
    .root {
      grid-template-columns: minmax(18rem, 1.5fr) minmax(9rem, 1fr);
      align-items: start;
    }

    .editor-pane {
      grid-column: 1;
    }

    .code-pane {
      grid-column: 2;
    }
  }

  @media (max-width: 899px) {
    .code-pane {
      max-height: 20rem;
    }
  }
</style>
