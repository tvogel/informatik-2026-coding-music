---
/*
 * Plots a reference wave (sine or triangle) over two periods together with
 * a copy that can be shifted horizontally (by dragging the plot, with the
 * arrow and page keys on it or with the slider) and the sum of both. A
 * play-only MiniRepl plays the two waves with the chosen shift, mixed (mono)
 * or the copy left and the reference right (stereo): moving the copy to the
 * right delays it on the left ear, so the sound moves to the right, too.
 */
import MiniRepl from "./MiniRepl.astro";
import { phaseTune, type Wave } from "../lib/phaseTune";

interface Props {
  /** initial wave */
  wave?: Wave;
  /** frequency of both waves in Hz */
  freq?: number;
  /** initial shift in degrees */
  degrees?: number;
}

const { wave = "sine", freq = 440, degrees = 90 } = Astro.props;
---

<phase-shift data-freq={freq} data-degrees={degrees}>
  <div class="controls not-content">
    <label>
      Verschiebung:
      <input type="range" min="0" max="360" step="1" value={degrees} autocomplete="off" />
    </label>
    <output></output>
    <label>
      Welle:
      <select name="wave" autocomplete="off">
        <option value="sine" selected={wave === "sine"}>Sinus</option>
        <option value="triangle" selected={wave === "triangle"}>Dreieck</option>
      </select>
    </label>
    <label>
      Wiedergabe:
      <select name="playback" autocomplete="off">
        <option value="mono">Mono: beide zusammen</option>
        <option value="stereo">Stereo: verschoben links, Referenz rechts</option>
      </select>
    </label>
  </div>
  <svg class="plot not-content" viewBox="0 0 400 170" role="img" tabindex="0">
    <line class="grid" x1="0" y1="85" x2="400" y2="85"></line>
    <line class="grid" x1="200" y1="10" x2="200" y2="160"></line>
    <path class="curve curve--reference"></path>
    <path class="curve curve--shifted"></path>
    <path class="curve curve--sum"></path>
    <circle class="handle" r="5"></circle>
    <circle class="handle" r="5"></circle>
  </svg>
  <p class="legend not-content">
    <span class="key key--reference">Referenz</span>
    <span class="key key--shifted">verschoben (ziehen, ←/→ oder Bild↑/↓)</span>
    <span class="key key--sum">Summe</span>
    <span class="stereo-note">
      Im Stereo-Modus hört jedes Ohr nur einen der beiden Töne: Die Summe
      entsteht dann nicht im Signal.
    </span>
  </p>
  <MiniRepl mode="playOnly" tune={phaseTune(wave, freq, degrees, false)} />
</phase-shift>

<script>
  import { setTune } from "../lib/miniRepl";
  import { phaseTune, waveShape, type Wave } from "../lib/phaseTune";

  // viewBox: two periods of 200 units, amplitude 35 around the middle line
  const PERIOD = 200;
  const MIDDLE = 85;
  const AMPLITUDE = 35;

  const path = (f: (x: number) => number) => {
    const points: string[] = [];
    for (let x = 0; x <= 2 * PERIOD; x += 2) {
      points.push(`${x},${(MIDDLE - AMPLITUDE * f(x)).toFixed(2)}`);
    }
    return `M${points.join("L")}`;
  };

  const describe = (degrees: number) => {
    const periods = (degrees / 360).toLocaleString("de-DE", {
      maximumFractionDigits: 3,
    });
    return `${degrees}° (${periods} Perioden)`;
  };

  class PhaseShift extends HTMLElement {
    connectedCallback() {
      const freq = Number(this.dataset.freq);
      const slider = this.querySelector<HTMLInputElement>("input[type=range]")!;
      const waveSelect = this.querySelector<HTMLSelectElement>("select[name=wave]")!;
      const playback = this.querySelector<HTMLSelectElement>("select[name=playback]")!;
      const output = this.querySelector("output")!;
      const svg = this.querySelector("svg")!;
      const [shifted, sum] = ["shifted", "sum"].map(
        (name) => this.querySelector(`.curve--${name}`)!,
      );
      const reference = this.querySelector(".curve--reference")!;
      const handles = this.querySelectorAll(".handle");

      let degrees = Number(slider.value);
      const draw = () => {
        const shape = waveShape(waveSelect.value as Wave);
        const at = (x: number) => shape(x / PERIOD);
        const shift = (degrees / 360) * PERIOD;
        reference.setAttribute("d", path(at));
        shifted.setAttribute("d", path((x) => at(x - shift)));
        sum.setAttribute("d", path((x) => at(x) + at(x - shift)));
        // where the shifted wave's periods begin
        handles.forEach((handle, i) => {
          handle.setAttribute("cx", String((shift + i * PERIOD) % (2 * PERIOD)));
          handle.setAttribute("cy", String(MIDDLE - AMPLITUDE * shape(0)));
        });
        slider.value = String(degrees);
        output.textContent = describe(degrees);
        svg.setAttribute(
          "aria-label",
          `Zwei ${waveSelect.value === "sine" ? "Sinus" : "Dreiecks"}kurven, um ${describe(degrees)} gegeneinander verschoben, und ihre Summe`,
        );
      };
      const play = () => {
        const repl = this.querySelector<HTMLElement>("strudel-editor");
        const stereo = playback.value === "stereo";
        this.classList.toggle("is-stereo", stereo);
        if (repl) setTune(repl, phaseTune(waveSelect.value as Wave, freq, degrees, stereo));
      };

      slider.addEventListener("input", () => {
        degrees = Number(slider.value);
        draw();
      });
      slider.addEventListener("change", play);
      waveSelect.addEventListener("change", () => {
        draw();
        play();
      });
      playback.addEventListener("change", play);

      // dragging anywhere on the plot moves the shifted wave along
      let drag: { x: number; degrees: number } | undefined;
      svg.addEventListener("pointerdown", (event) => {
        drag = { x: event.clientX, degrees };
        svg.setPointerCapture(event.pointerId);
      });
      svg.addEventListener("pointermove", (event) => {
        if (!drag) return;
        const units = ((event.clientX - drag.x) * 400) / svg.getBoundingClientRect().width;
        const moved = Math.round(drag.degrees + (units / PERIOD) * 360);
        degrees = ((moved % 360) + 360) % 360;
        draw();
      });
      const endDrag = () => {
        if (!drag) return;
        const changed = drag.degrees !== degrees;
        drag = undefined;
        if (changed) play();
      };
      svg.addEventListener("pointerup", endDrag);
      svg.addEventListener("pointercancel", endDrag);

      // keys on the focused plot; the sound follows once they rest
      const STEPS: Record<string, number> = {
        ArrowRight: 5,
        ArrowLeft: -5,
        // as on the keyboard: page down sits above the right arrow
        PageDown: 15,
        PageUp: -15,
      };
      let keyTimer: ReturnType<typeof setTimeout> | undefined;
      svg.addEventListener("keydown", (event) => {
        const step = STEPS[event.key];
        if (step === undefined) return;
        event.preventDefault();
        degrees = (((degrees + step) % 360) + 360) % 360;
        draw();
        clearTimeout(keyTimer);
        keyTimer = setTimeout(play, 300);
      });

      draw();
    }
  }
  customElements.define("phase-shift", PhaseShift);
</script>

<style>
  phase-shift {
    display: block;
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    align-items: center;
  }

  label {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    max-width: 100%;
  }

  input[type="range"] {
    width: 12rem;
    accent-color: var(--sl-color-orange);
  }

  output {
    min-width: 11rem;
    font-variant-numeric: tabular-nums;
  }

  select {
    max-width: 100%;
    padding: 0.2rem 0.4rem;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 0.25rem;
    background-color: var(--sl-color-black);
    color: var(--sl-color-white);
  }

  .plot {
    display: block;
    width: 100%;
    max-width: 50rem;
    margin-top: 0.75rem;
    cursor: ew-resize;
    /* horizontal drags move the sine, vertical ones still scroll */
    touch-action: pan-y;
    user-select: none;
  }

  .plot:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  .grid {
    stroke: var(--sl-color-gray-5);
    stroke-width: 1;
  }

  .curve {
    fill: none;
    stroke-width: 2;
    stroke-linejoin: round;
  }

  .curve--reference,
  .key--reference::before {
    stroke: var(--sl-color-accent);
    background-color: var(--sl-color-accent);
  }

  .curve--shifted,
  .key--shifted::before {
    stroke: var(--sl-color-orange);
    background-color: var(--sl-color-orange);
  }

  .curve--sum,
  .key--sum::before {
    stroke: var(--sl-color-white);
    background-color: var(--sl-color-white);
  }

  .curve--sum {
    stroke-width: 3;
  }

  .handle {
    fill: var(--sl-color-orange);
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin: 0.25rem 0 0.5rem;
    font-size: var(--sl-text-sm);
  }

  .key::before {
    content: "";
    display: inline-block;
    width: 1.25em;
    height: 3px;
    margin-inline-end: 0.4em;
    vertical-align: middle;
  }

  .stereo-note {
    display: none;
    flex-basis: 100%;
    color: var(--sl-color-gray-3);
  }

  .is-stereo .stereo-note {
    display: block;
  }

  .is-stereo .curve--sum {
    stroke-dasharray: 6 5;
    opacity: 0.5;
  }
</style>
